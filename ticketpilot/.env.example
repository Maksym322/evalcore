# Copy to .env and fill in. NEVER commit .env. Values are examples/placeholders only.

# SQLAlchemy async URL. For Supabase, use the connection string + your DB password
# (NOT the JWT / API keys). Prefer the pooled connection string.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Pipeline knobs
ACTIVE_STRATEGY=fixed_512_50
ACTIVE_EMBED_MODEL=text-embedding-3-small
TOP_K=5
CONF_THRESHOLD=0.6
LLM_MODEL=claude-sonnet-4-6

# Secrets (leave blank here; set the real values in your untracked .env or platform secrets)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
EVAL_TOKEN=
