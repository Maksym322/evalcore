# Copy to .env and fill in. NEVER commit .env. Values are examples/placeholders only.

# Local Compose settings. Set a random password before sharing the stack.
POSTGRES_PASSWORD=ticketpilot_dev_only
TICKETPILOT_PORT=18000

# For host-side Python commands, set a reachable SQLAlchemy async URL.
# Compose constructs its own DATABASE_URL using the db service name.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# Pipeline knobs
ACTIVE_STRATEGY=fixed_512_50
ACTIVE_EMBED_MODEL=gemini-embedding-2
TOP_K=5
CONF_THRESHOLD=0.6
LLM_MODEL=gemini-3.5-flash-lite

# Secrets (leave blank here; set the real values in your untracked .env or platform secrets)
GEMINI_API_KEY=
API_TOKEN=
EVAL_TOKEN=
